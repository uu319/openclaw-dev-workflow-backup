graph TB
    %% Definitions
    DiscordChan[Discord #channel] -->|ch+acct+peer| Bindings{Bindings\nmost specific wins}
    DiscordDM[Discord DM] -->|ch+acct+peer| Bindings
    TelegramDM[Telegram DM] -->|ch+acct+peer| Bindings
    Cron[Cron job] --> Bindings
    Subagent[sessions_spawn] --> Bindings

    Bindings --> SessionKey{Session Key\ndmScope: main}

    %% Main Agent
    subgraph MainAgent [Agent: main]
        SessionKey -->|agent:main:main| MainSession[(Main Session)]
        SessionKey -->|agent:main:discord:channel:id| ChanSession[(Channel Session)]
        SessionKey -->|fresh per run| CronSession[(Cron Session)]
        
        MainSession --> Transcripts[(SQLite Transcripts)]
        ChanSession --> Transcripts
        CronSession --> Transcripts
    end

    %% Work Agent
    subgraph WorkAgent [Agent: work]
        Bindings -.->|different peer| WorkKey{Session Key}
        WorkKey -->|agent:work:discord:channel:id| WorkChan[(Channel Session)]
        WorkChan --> WorkTranscripts[(SQLite Transcripts)]
    end

    classDef input fill:#bfdbfe,stroke:#64748b,color:#172033
    classDef process fill:#c7d2fe,stroke:#64748b,color:#172033
    classDef storage fill:#99f6e4,stroke:#64748b,color:#172033
    
    class DiscordChan,DiscordDM,TelegramDM,Cron,Subagent input
    class Bindings,SessionKey,WorkKey process
    class MainSession,ChanSession,CronSession,Transcripts,WorkChan,WorkTranscripts storage
